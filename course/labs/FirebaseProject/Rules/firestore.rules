rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validNote(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerID', 'title', 'revision', 'updatedAt'])
        && d.keys().hasOnly(['ownerID', 'title', 'revision', 'updatedAt'])
        && d.ownerID == uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.revision is int && d.revision >= 0
        && d.updatedAt == request.time;
    }
    match /users/{uid}/notes/{noteID} {
      allow get: if owner(uid);
      allow list: if owner(uid) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 25;
      allow create: if owner(uid) && validNote(uid)
        && request.resource.data.revision == 0;
      allow update: if owner(uid) && validNote(uid)
        && resource.data.ownerID == uid
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'revision', 'updatedAt']);
      allow delete: if owner(uid);
    }
    // All other paths, including token registries and administrative data, deny.
    match /{document=**} { allow read, write: if false; }
  }
}
