{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$connection": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['online', 'lastChanged'])",
          "online": { ".validate": "newData.isBoolean() && newData.val() === true" },
          "lastChanged": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
